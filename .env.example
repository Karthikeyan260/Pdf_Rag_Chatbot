# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (docker-compose overrides host to `postgres`) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docintel

# --- Redis / Celery (docker-compose overrides host to `redis`) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ---
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=500

# --- Provider selection ---
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=bge_m3
RERANKER_PROVIDER=bge
VECTORSTORE_PROVIDER=qdrant

# --- Gemini (live in Phase 1 — get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Phase 2 stub providers (fill in when their adapters are implemented) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLAMA_BASE_URL=
JINA_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Vector store (docker-compose overrides host to `qdrant`) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
